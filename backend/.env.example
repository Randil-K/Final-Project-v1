# Environment for a hosted deployment. Copy the names into your host's settings — never commit real values.

# Required. 32+ characters. Generate one with:  openssl rand -base64 48
TIDELINE_JWT_SECRET=

# Database (MySQL 8).
DB_HOST=
DB_PORT=3306
DB_NAME=tideline
DB_USERNAME=
DB_PASSWORD=
# Or, if your host gives you a single connection string, use this instead of the DB_* values:
# SPRING_DATASOURCE_URL=jdbc:mysql://host:3306/tideline

# Comma-separated browser origins allowed to call the API — your Vercel domain(s).
# Wildcards are supported, e.g. https://final-project-v1-*-randil.vercel.app for preview deploys.
CORS_ALLOWED_ORIGINS=https://final-project-v1-git-main-randil.vercel.app

# Load the demo accounts and reports into an empty database (useful for a supervisor demo).
SEED_DEMO_DATA=false

# Where volunteer divers' certificate files are stored. Point it at a persistent disk or volume,
# otherwise uploads are lost when the container restarts. The Dockerfile defaults to /app/uploads.
# UPLOADS_DIR=/app/uploads

# Already set by the Dockerfile; override only if you know you need to.
# SPRING_PROFILES_ACTIVE=mysql
# PORT is injected by most hosts (Render, Railway, Fly.io); the app defaults to 8080.
