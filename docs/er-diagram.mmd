erDiagram
    %% ============================================================
    %% Ocean & Coastal Cleanup Management System — ER Diagram
    %% Reflects the workflow confirmed 2026-09-03: cleanup request
    %% post -> community verification -> admin review -> government
    %% approval -> auto-created cleanup project -> alert/recruitment
    %% -> owner finalizes -> progress tracking.
    %% ============================================================

    %% ---------- Users & role subtypes (ISA) ----------
    USER {
        int userId PK
        string firstName
        string lastName
        string email UK
        string password
        string phone
        string role "VOLUNTEER_NON_DIVER / VOLUNTEER_DIVER / ORGANIZATION / GOVERNMENT_OFFICER / ADMIN"
        string status "ACTIVE / WARNED / RESTRICTED / SUSPENDED"
        date dateOfBirth
        string addressLine
        decimal latitude "geocoded from address, used for alert radius"
        decimal longitude
        datetime createdDate
    }

    VOLUNTEER_NON_DIVER {
        int userId PK "FK -> USER"
        string availability
        string specialization
    }

    VOLUNTEER_INTEREST {
        int interestId PK
        int userId FK
        string interest
    }

    VOLUNTEER_DIVER {
        int userId PK "FK -> USER"
        string experience
        string certification
        string preferredRegion
    }

    DIVER_EQUIPMENT {
        int equipmentId PK
        int userId FK
        string equipmentName
    }

    ORGANIZATION {
        int userId PK "FK -> USER"
        string organizationName
        string organizationType
        string businessRegNum
    }

    GOVERNMENT_OFFICER {
        int userId PK "FK -> USER"
        string department
        string designation
    }

    ADMIN {
        int userId PK "FK -> USER"
    }

    %% ---------- Registration verification (diver / org only) ----------
    VERIFICATION_DOCUMENT {
        int documentId PK
        int userId FK
        string documentType
        string fileUrl
        datetime uploadedDate
    }

    REGISTRATION_VERIFICATION {
        int verificationId PK
        int userId FK UK "applicant"
        string status "PENDING / NEEDS_CLARIFICATION / RESUBMITTED / APPROVED / REJECTED"
        datetime submittedDate
    }

    REGISTRATION_REVIEW_ACTION {
        int actionId PK
        int verificationId FK
        int reviewerId FK "Admin userId"
        string decision "APPROVE / REJECT / CLARIFY"
        string comment
        datetime actionDate
    }

    %% ---------- Cleanup request post: report -> verify -> approve ----------
    DISTRICT {
        int districtId PK
        string districtName
    }

    CLEANUP_REQUEST_POST {
        int requestPostId PK
        int submittedByUserId FK
        string description
        datetime incidentDateTime
        decimal latitude
        decimal longitude
        int districtId FK "for regional analytics rollups"
        string currentStage "COMMUNITY / ADMIN / GOVERNMENT / CLOSED"
        string stageStatus "PENDING / NEEDS_CLARIFICATION / RESUBMITTED / APPROVED / REJECTED"
        string communityResult "PENDING / VERIFIED / UNVERIFIED"
        decimal trustPercentage
        datetime submittedDate
        datetime verificationDeadline "submittedDate + 14 days"
    }

    REQUEST_POST_MEDIA {
        int mediaId PK
        int requestPostId FK
        string fileUrl
        string fileType
        datetime uploadedDate
    }

    REPORT_VOTE {
        int voteId PK
        int requestPostId FK
        int userId FK
        boolean voteValue
        datetime votedDate
    }

    REPORT_COMMENT {
        int commentId PK
        int requestPostId FK
        int userId FK
        string commentText
        datetime createdDate
    }

    REPORT_REVIEW_ACTION {
        int actionId PK
        int requestPostId FK
        int reviewerId FK "Admin or Government Officer userId"
        string reviewStage "ADMIN / GOVERNMENT"
        string decision "APPROVE / REJECT / CLARIFY"
        string comment "rejection reason, or cleanup instructions on approve"
        datetime actionDate
    }

    %% ---------- Sanctions (false report -> warning -> restriction) ----------
    USER_SANCTION {
        int sanctionId PK
        int userId FK "sanctioned user"
        int issuedByAdminId FK
        string type "WARNING / RESTRICTION"
        string reason
        int relatedRequestPostId FK "nullable"
        datetime issuedDate
    }

    %% ---------- Cleanup project: auto-created on government approval ----------
    CLEANUP_PROJECT {
        int projectId PK
        int requestPostId FK UK "originating post, 1:1"
        int ownerId FK "= requestPost.submittedByUserId"
        string status "PLANNING / PARTICIPANT_RECRUITMENT / DETAILS_FINALIZED / READY_FOR_CLEANUP / CLEANUP_IN_PROGRESS / COMPLETED / CANCELLED"
        int diversNeeded
        int participantsNeeded
        int minimumParticipants "threshold set by owner"
        string specialistsNeeded
        string equipmentRequired
        int currentAlertRadiusKm
        date initiationDate
        datetime createdDate
        datetime finalizedDate
    }

    PROJECT_ALERT {
        int alertId PK
        int projectId FK
        int radiusKm "10, 20, 30... escalation tier"
        datetime sentDate
    }

    PROJECT_ALERT_RECIPIENT {
        int recipientId PK
        int alertId FK
        int userId FK
        datetime notifiedDate
        string response "PENDING / JOINED / DECLINED / IGNORED"
    }

    PROJECT_PARTICIPANT {
        int participantId PK
        int projectId FK
        int userId FK
        string role "PARTICIPANT / DIVER"
        string status "CONFIRMED / WITHDRAWN"
        datetime joinedDate
    }

    PROJECT_PROGRESS_UPDATE {
        int updateId PK
        int projectId FK
        int updatedByUserId FK
        string notes
        datetime updateDate
    }

    PROJECT_PROGRESS_IMAGE {
        int imageId PK
        int updateId FK
        string imageUrl
    }

    %% ---------- Notifications (generic log) ----------
    NOTIFICATION {
        int notificationId PK
        int userId FK "recipient"
        string message
        string type "REPORT_STATUS / PROJECT_ALERT / PROJECT_STATUS / CLARIFICATION / SANCTION / ..."
        string priorityLevel
        datetime sentDate
        boolean readStatus
    }

    %% ---------- Diver Opportunity module (separate, org-initiated) ----------
    DIVER_OPPORTUNITY {
        int opportunityId PK
        int organizationId FK
        string title
        string description
        string location
        string requiredSkills
        string status
        date postedDate
    }

    OPPORTUNITY_SIGNUP {
        int signupId PK
        int opportunityId FK
        int diverId FK
        string status "INTERESTED / SELECTED / REJECTED"
        datetime signupDate
    }

    %% ============================================================
    %% Relationships
    %% ============================================================
    USER ||--o| VOLUNTEER_NON_DIVER : "is a"
    USER ||--o| VOLUNTEER_DIVER : "is a"
    USER ||--o| ORGANIZATION : "is a"
    USER ||--o| GOVERNMENT_OFFICER : "is a"
    USER ||--o| ADMIN : "is a"

    VOLUNTEER_NON_DIVER ||--o{ VOLUNTEER_INTEREST : lists
    VOLUNTEER_DIVER ||--o{ DIVER_EQUIPMENT : lists

    USER ||--o{ VERIFICATION_DOCUMENT : uploads
    USER ||--o| REGISTRATION_VERIFICATION : requires
    REGISTRATION_VERIFICATION ||--o{ REGISTRATION_REVIEW_ACTION : "has history"
    USER ||--o{ REGISTRATION_REVIEW_ACTION : reviews

    DISTRICT ||--o{ CLEANUP_REQUEST_POST : contains
    USER ||--o{ CLEANUP_REQUEST_POST : submits
    CLEANUP_REQUEST_POST ||--o{ REQUEST_POST_MEDIA : includes
    CLEANUP_REQUEST_POST ||--o{ REPORT_VOTE : receives
    USER ||--o{ REPORT_VOTE : casts
    CLEANUP_REQUEST_POST ||--o{ REPORT_COMMENT : has
    USER ||--o{ REPORT_COMMENT : writes
    CLEANUP_REQUEST_POST ||--o{ REPORT_REVIEW_ACTION : "has history"
    USER ||--o{ REPORT_REVIEW_ACTION : reviews

    USER ||--o{ USER_SANCTION : "sanctioned"
    USER ||--o{ USER_SANCTION : issues
    CLEANUP_REQUEST_POST ||--o{ USER_SANCTION : "grounds for"

    CLEANUP_REQUEST_POST ||--o| CLEANUP_PROJECT : "promoted to"
    USER ||--o{ CLEANUP_PROJECT : owns

    CLEANUP_PROJECT ||--o{ PROJECT_ALERT : triggers
    PROJECT_ALERT ||--o{ PROJECT_ALERT_RECIPIENT : notifies
    USER ||--o{ PROJECT_ALERT_RECIPIENT : receives

    CLEANUP_PROJECT ||--o{ PROJECT_PARTICIPANT : has
    USER ||--o{ PROJECT_PARTICIPANT : joins

    CLEANUP_PROJECT ||--o{ PROJECT_PROGRESS_UPDATE : has
    USER ||--o{ PROJECT_PROGRESS_UPDATE : posts
    PROJECT_PROGRESS_UPDATE ||--o{ PROJECT_PROGRESS_IMAGE : includes

    USER ||--o{ NOTIFICATION : receives

    USER ||--o{ DIVER_OPPORTUNITY : posts
    DIVER_OPPORTUNITY ||--o{ OPPORTUNITY_SIGNUP : has
    USER ||--o{ OPPORTUNITY_SIGNUP : "signs up"
